{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pact-api",
  "main": "src/server/index.ts",
  "compatibility_date": "2025-10-06",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pact-prod",
      "database_id": "58686a9a-0803-4842-b1e4-3adade33417a"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "GROQ_MODEL": "openai/gpt-oss-120b"
  }
}
