{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pact-web",
  "main": "src/server/frontend.ts",
  "compatibility_date": "2025-10-06",
  "workers_dev": true,
  "vars": {
    "REQUIRE_LOGIN": "false"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "services": [
    {
      "binding": "API",
      "service": "pact-api"
    }
  ]
}
